{
  "name": "laravel-migration-visualizer",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @lmv/web",
    "build": "npm run build -w @lmv/migration-core && npm run build -w @lmv/web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p packages/migration-core/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "demo:project": "npm run build -w @lmv/migration-core && node examples/project-analysis.mjs",
    "demo:tables": "npm run build -w @lmv/migration-core && node examples/table-lifecycle.mjs",
    "demo:helpers": "npm run build -w @lmv/migration-core && node examples/column-helpers.mjs",
    "demo:changes": "npm run build -w @lmv/migration-core && node examples/change-columns.mjs",
    "demo:laravel": "npm run build -w @lmv/migration-core && node examples/laravel-baseline.mjs",
    "demo:index-rename": "npm run build -w @lmv/migration-core && node examples/rename-index.mjs",
    "demo:current-update": "npm run build -w @lmv/migration-core && node examples/current-on-update.mjs",
    "demo:drop-columns": "npm run build -w @lmv/migration-core && node examples/drop-columns.mjs",
    "demo:drop-constrained-id": "npm run build -w @lmv/migration-core && node examples/drop-constrained-id.mjs",
    "demo:morphs": "npm run build -w @lmv/migration-core && node examples/morphs.mjs",
    "demo:acceptance": "npm run build -w @lmv/migration-core && node examples/acceptance.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
